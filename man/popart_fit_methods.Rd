] <- NA_integer_
auxiliary <- cars[c("wt", "hp")]
fit <- fit_popart(
  trial_data = trial,
  auxiliary_data = auxiliary,
  outcome = "outcome",
  treatment = "treatment",
  response = "responded",
  censoring = "censored",
  covariates = c("wt", "hp"),
  control = popart_control(
    n_lambda_values = 5L,
    max_degree = 1L,
    num_knots = 1L,
    random_seed = 20260806L
